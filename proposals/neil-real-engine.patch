new file mode 100644
index 0000000..f89e9dd
--- /dev/null
+++ b/backend/app/engine_real.py
@@ -0,0 +1,144 @@
+"""Adapts the dict-based B/C engine to the Pydantic signatures in `engine_port`.
+
+Developer B's state/policy/explanations and Developer C's evaluator accept and
+return JSON-compatible mappings. This module validates their output with A's
+schemas and translates engine errors into the API envelope. It holds no
+financial rules of its own.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from app.engine import assumptions as _assumptions
+from app.engine import explanations as _explanations
+from app.engine import policy as _policy
+from app.engine import state as _state
+from app.engine.evaluate import evaluate as _evaluate
+from app.engine.monthly import InfeasibleScenario
+from app.engine.validation import ProfileValidationError
+from app.errors import ApiError
+from app.schemas import (
+    AIExplanation,
+    Change,
+    DecisionSummary,
+    EvaluationCore,
+    FinancialProfile,
+    FinancialState,
+    RecommendationProposal,
+    Scenario,
+)
+
+MODEL_VERSION: str = _assumptions.MODEL_VERSION
+POLICY_VERSION: str = _assumptions.POLICY_VERSION
+
+_FIXTURES = Path(__file__).resolve().parent.parent / "fixtures" / "profiles.json"
+_BLOCKING = ("MISSING_REQUIRED_INPUT", "CASH_FLOW_SHORTFALL")
+# BACKEND_TEAM_SPLIT.md: the preference table governs standard profiles; only the
+# documented Morgan cash-security variant may demonstrate a non-default order.
+_ORDER_EXCEPTIONS = {"morgan-cash-security": ["starter_reserve", "high_apr_debt", "full_reserve"]}
+
+
+def _data(model) -> dict:
+    return model.model_dump(mode="json")
+
+
+def _profile_error(exc: ProfileValidationError) -> ApiError:
+    message = str(exc).removeprefix(f"{exc.path}: ")
+    return ApiError(422, "INVALID_PROFILE", message, [exc.path])
+
+
+def load_demo_profiles() -> list[FinancialProfile]:
+    data = json.loads(_FIXTURES.read_text(encoding="utf-8"))
+    return [FinancialProfile.model_validate(p) for p in data]
+
+
+def derive_state(profile: FinancialProfile) -> FinancialState:
+    try:
+        return FinancialState.model_validate(_state.derive_state(_data(profile)))
+    except ProfileValidationError as exc:
+        raise _profile_error(exc) from exc
+
+
+def blocking_issue(profile: FinancialProfile, state: FinancialState) -> str | None:
+    return next((code for code in _BLOCKING if code in state.warnings), None)
+
+
+def default_order(planning_preference: str) -> list[str]:
+    return list(_policy.default_priorities(planning_preference))
+
+
+def permitted_orders(profile: FinancialProfile) -> list[list[str]]:
+    """The preference default first, then the profile's documented exception if any."""
+    orders = [default_order(profile.planning_preference)]
+    extra = _ORDER_EXCEPTIONS.get(profile.id)
+    if extra and extra not in orders:
+        orders.append(list(extra))
+    return orders
+
+
+def agent_indicators(profile: FinancialProfile, state: FinancialState) -> dict[str, float | int | str | None]:
+    """B's allowlisted recommendation context, flattened so keys are evidence paths."""
+    context = _state.recommendation_context(_data(profile), _data(state))
+    nested = context.pop("financial_state")
+    return {**context, **{f"financial_state.{k}": v for k, v in nested.items()}}
+
+
+def validate_decision(
+    profile: FinancialProfile,
+    state: FinancialState,
+    proposal: RecommendationProposal | None,
+    *,
+    decision_id: str,
+    prompt_version: str,
+    fallback_reason: str | None = None,
+) -> DecisionSummary:
+    raw = None if proposal is None else {
+        "ordered_priorities": list(proposal.ordered_priorities),
+        "rationale": [r.model_dump() for r in proposal.rationale],
+    }
+    decision = _policy.validate_decision(
+        _data(profile), _data(state), raw,
+        model_id=proposal.model_id if proposal else None,
+        prompt_version=prompt_version,
+    )
+    if decision["source"] == "ai" and decision["ordered_priorities"] not in permitted_orders(profile):
+        decision = _policy.validate_decision(_data(profile), _data(state), None, prompt_version=prompt_version)
+        decision["fallback_reason"] = "ORDER_NOT_PERMITTED"
+    decision["decision_id"] = decision_id
+    if decision["source"] == "rules_fallback":
+        # A's orchestration knows why no proposal exists; B knows why one was rejected.
+        decision["fallback_reason"] = (
+            f"invalid_proposal: {decision['fallback_reason'].lower()}" if proposal is not None
+            else fallback_reason or decision["fallback_reason"]
+        )
+    return DecisionSummary.model_validate(decision)
+
+
+def evaluate(profile: FinancialProfile, scenario: Scenario | None, decision: DecisionSummary) -> EvaluationCore:
+    try:
+        evaluation = _evaluate(
+            profile, scenario, decision,
+            model_version=MODEL_VERSION, policy_version=POLICY_VERSION,
+        )
+    except ProfileValidationError as exc:
+        raise _profile_error(exc) from exc
+    except InfeasibleScenario as exc:
+        raise ApiError(
+            422, "INFEASIBLE_SCENARIO",
+            f"This scenario is short ${exc.shortfall_cents / 100:,.2f} in month {exc.month}. "
+            "Choose a lower contribution rate or a different retirement age.",
+            ["scenario.employee_contribution_rate"],
+        ) from exc
+    return EvaluationCore.model_validate(
+        evaluation.model_dump(exclude={"decision_summary", "explanation"})
+    )
+
+
+def template_explanation(
+    profile: FinancialProfile, core: EvaluationCore, decision: DecisionSummary, changes: list[Change]
+) -> AIExplanation:
+    return AIExplanation.model_validate(_explanations.template_explanation(
+        _data(profile), _data(core.financial_state), _data(decision), _data(core.plan),
+        changes=[c.model_dump(mode="json") for c in changes],
+    ))
