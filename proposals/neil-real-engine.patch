diff --git a/backend/tests/test_engine_integration.py b/backend/tests/test_engine_integration.py
new file mode 100644
index 0000000..671b054
--- /dev/null
+++ b/backend/tests/test_engine_integration.py
@@ -0,0 +1,58 @@
+"""The API serves the real B/C engine, and agrees with the exporter's evaluator."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from app.engine.evaluate import evaluate as engine_evaluate
+from app.schemas import DecisionSummary, FinancialProfile, Scenario
+
+from .conftest import FakeModel, make_client, recommendation
+
+BALANCED = ["starter_reserve", "high_apr_debt", "full_reserve"]
+CASH_SECURITY = ["starter_reserve", "full_reserve", "high_apr_debt"]
+VARIANT = Path(__file__).parents[1] / "fixtures" / "morgan-cash-security-profile.json"
+
+
+def post(profile, scenario=None, model=None):
+    return make_client(model).post("/v1/evaluate", json={"profile": profile, "scenario": scenario})
+
+
+def test_morgan_api_returns_real_plan_and_projections(morgan):
+    body = post(morgan).json()
+    assert not any(w.startswith("STUB_ENGINE") for w in body["warnings"])
+    card = next(r for r in body["plan"]["reasons"] if r["facts"].get("debt_id") == morgan["debts"][0]["id"])
+    assert card["facts"]["extra_payment_cents"] == 96380
+    for strategy in ("current", "adaptive"):
+        projection = body["projections"][strategy]
+        assert projection["feasible"] and projection["points"][0]["month"] == 0
+        assert len(projection["points"]) == 12 * (morgan["retirement_age"] - morgan["age"]) + 1
+
+
+def test_api_numbers_equal_exporter_evaluator(morgan):
+    scenario = {"retirement_age": morgan["retirement_age"] + 2, "employee_contribution_rate": None}
+    body = post(morgan, scenario).json()
+    decision = DecisionSummary.model_validate(body["decision_summary"])
+    direct = engine_evaluate(FinancialProfile.model_validate(morgan), Scenario.model_validate(scenario), decision)
+    direct = direct.model_dump(mode="json")
+    for key in ("input_hash", "financial_state", "plan", "assumptions", "projections"):
+        assert body[key] == direct[key], key
+
+
+def test_unaffordable_custom_rate_is_422(morgan):
+    res = post(morgan, {"retirement_age": morgan["retirement_age"], "employee_contribution_rate": 0.29})
+    assert res.status_code == 422
+    assert res.json()["error"]["code"] == "INFEASIBLE_SCENARIO"
+
+
+def test_standard_profile_cannot_take_non_default_order(morgan):
+    d = post(morgan, model=FakeModel(recommend=recommendation(CASH_SECURITY))).json()["decision_summary"]
+    assert d["source"] == "rules_fallback"
+    assert d["fallback_reason"] == "invalid_proposal: order_not_permitted"
+    assert d["ordered_priorities"] == BALANCED
+
+
+def test_variant_accepts_documented_exception_through_real_policy():
+    variant = json.loads(VARIANT.read_text())
+    d = post(variant, model=FakeModel(recommend=recommendation(BALANCED))).json()["decision_summary"]
+    assert d["source"] == "ai" and d["ordered_priorities"] == BALANCED
