  "components": {
    "schemas": {
      "AIExplanation": {
        "properties": {
          "state_summary": {
            "type": "string",
            "title": "State Summary"
          },
          "narrative": {
            "type": "string",
            "title": "Narrative"
          },
          "source": {
            "type": "string",
            "enum": [
              "ai",
              "template"
            ],
            "title": "Source"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/Change"
            },
            "type": "array",
            "title": "Changes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state_summary",
          "narrative",
          "source",
          "changes"
        ],
        "title": "AIExplanation"
      },
      "Change": {
        "properties": {
          "field_path": {
            "type": "string",
            "title": "Field Path"
          },
          "before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Before"
          },
          "after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "After"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field_path",
          "before",
          "after"
        ],
        "title": "Change"
      },
      "ConstraintCheck": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "passed"
        ],
        "title": "ConstraintCheck"
      },
      "Debt": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "credit_card",
              "student_loan",
              "other"
            ],
            "title": "Type"
          },
          "balance_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Balance Cents"
          },
          "apr": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Apr"
          },
          "minimum_payment_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Minimum Payment Cents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "type",
          "balance_cents",
          "apr",
          "minimum_payment_cents"
        ],
        "title": "Debt"
      },
      "DecisionSummary": {
        "properties": {
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "ai",
              "rules_fallback"
            ],
            "title": "Source"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "ordered_priorities": {
            "items": {
              "type": "string",
              "enum": [
                "starter_reserve",
                "high_apr_debt",
                "full_reserve"
              ]
            },
            "type": "array",
            "title": "Ordered Priorities"
          },
          "rationale": {
            "items": {
              "$ref": "#/components/schemas/Rationale"
            },
            "type": "array",
            "title": "Rationale"
          },
          "constraint_checks": {
            "items": {
              "$ref": "#/components/schemas/ConstraintCheck"
            },
            "type": "array",
            "title": "Constraint Checks"
          },
          "fallback_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision_id",
          "source",
          "model_id",
          "prompt_version",
          "ordered_priorities",
          "rationale",
          "constraint_checks",
          "fallback_reason"
        ],
        "title": "DecisionSummary"
      },
      "DemoProfiles": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/FinancialProfile"
            },
            "type": "array",
            "title": "Profiles"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "profiles"
        ],
        "title": "DemoProfiles"
      },
      "EmployerMatch": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "none",
              "unknown"
            ],
            "title": "Status"
          },
          "fully_vested": {
            "type": "boolean",
            "title": "Fully Vested"
          },
          "tiers": {
            "items": {
              "$ref": "#/components/schemas/MatchTier"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Tiers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "fully_vested",
          "tiers"
        ],
        "title": "EmployerMatch"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "field_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Field Paths"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "field_paths",
          "retryable"
        ],
        "title": "ErrorBody"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "EvaluateRequest": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/FinancialProfile"
          },
          "scenario": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Scenario"
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_decision_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Decision Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile"
        ],
        "title": "EvaluateRequest"
      },
      "Evaluation": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version"
          },
          "profile_id": {
            "type": "string",
            "title": "Profile Id"
          },
          "input_hash": {
            "type": "string",
            "title": "Input Hash"
          },
          "financial_state": {
            "$ref": "#/components/schemas/FinancialState"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "assumptions": {
            "$ref": "#/components/schemas/ModelAssumptions"
          },
          "projections": {
            "$ref": "#/components/schemas/Projections"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "decision_summary": {
            "$ref": "#/components/schemas/DecisionSummary"
          },
          "explanation": {
            "$ref": "#/components/schemas/AIExplanation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "model_version",
          "policy_version",
          "profile_id",
          "input_hash",
          "financial_state",
          "plan",
          "assumptions",
          "projections",
          "warnings",
          "decision_summary",
          "explanation"
        ],
        "title": "Evaluation"
      },
      "FinancialProfile": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "as_of_date": {
            "type": "string",
            "format": "date",
            "title": "As Of Date"
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency"
          },
          "source": {
            "type": "string",
            "enum": [
              "demo",
              "plaid_sandbox"
            ],
            "title": "Source"
          },
          "age": {
            "type": "integer",
            "maximum": 75.0,
            "minimum": 18.0,
            "title": "Age"
          },
          "retirement_age": {
            "type": "integer",
            "maximum": 80.0,
            "title": "Retirement Age"
          },
          "annual_gross_salary_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Annual Gross Salary Cents"
          },
          "monthly_take_home_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Monthly Take Home Cents"
          },
          "monthly_living_expenses_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Monthly Living Expenses Cents"
          },
          "annual_employee_limit_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Annual Employee Limit Cents"
          },
          "employee_contribution_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Employee Contribution Rate"
          },
          "contribution_tax_treatment": {
            "type": "string",
            "enum": [
              "traditional",
              "roth"
            ],
            "title": "Contribution Tax Treatment"
          },
          "estimated_marginal_income_tax_rate": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Estimated Marginal Income Tax Rate"
          },
          "retirement_balance_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Retirement Balance Cents"
          },
          "emergency_cash_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Emergency Cash Cents"
          },
          "employer_match": {
            "$ref": "#/components/schemas/EmployerMatch"
          },
          "debts": {
            "items": {
              "$ref": "#/components/schemas/Debt"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Debts"
          },
          "planning_preference": {
            "type": "string",
            "enum": [
              "balanced",
              "cash_security",
              "debt_reduction"
            ],
            "title": "Planning Preference",
            "default": "balanced"
          },
          "provenance": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Provenance"
            },
            "type": "object",
            "title": "Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "as_of_date",
          "currency",
          "source",
          "age",
          "retirement_age",
          "annual_gross_salary_cents",
          "monthly_take_home_cents",
          "monthly_living_expenses_cents",
          "annual_employee_limit_cents",
          "employee_contribution_rate",
          "contribution_tax_treatment",
          "estimated_marginal_income_tax_rate",
          "retirement_balance_cents",
          "emergency_cash_cents",
          "employer_match",
          "debts",
          "provenance"
        ],
        "title": "FinancialProfile"
      },
      "FinancialState": {
        "properties": {
          "months_until_retirement": {
            "type": "integer",
            "title": "Months Until Retirement"
          },
          "gross_monthly_salary_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Gross Monthly Salary Cents"
          },
          "current_employee_contribution_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Current Employee Contribution Cents"
          },
          "current_employee_cash_cost_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Current Employee Cash Cost Cents"
          },
          "monthly_resources_before_retirement_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Monthly Resources Before Retirement Cents"
          },
          "monthly_required_debt_payments_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Monthly Required Debt Payments Cents"
          },
          "monthly_allocatable_budget_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Monthly Allocatable Budget Cents"
          },
          "current_monthly_surplus_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Current Monthly Surplus Cents"
          },
          "emergency_months": {
            "type": "number",
            "title": "Emergency Months"
          },
          "critical_reserve_target_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Critical Reserve Target Cents"
          },
          "starter_reserve_target_cents": {
            "type": "integer",
            "maximum": 10000000000000.0,
            "minimum": -10000000000000.0,
            "title": "Starter Reserve Target Cents"
          },
          "full_reserve_target_cents": {
