diff --git a/backend/tests/test_scenario_fast_path.py b/backend/tests/test_scenario_fast_path.py
new file mode 100644
index 0000000..97f858f
--- /dev/null
+++ b/backend/tests/test_scenario_fast_path.py
@@ -0,0 +1,55 @@
+"""Scenario fast path: `reuse_decision` skips the AI steps and reproduces a full evaluation."""
+from __future__ import annotations
+
+import copy
+
+from .conftest import FakeModel, make_client
+
+
+def _plan_and_model(morgan):
+    model = FakeModel()
+    client = make_client(model, openai_api_key="x", evaluations_per_minute=1000)
+    plan = client.post("/v1/evaluate", json={"profile": morgan}).json()
+    assert plan["decision_summary"]["source"] == "ai"
+    return client, model, plan
+
+
+def test_reused_decision_skips_the_ai_and_matches_a_full_evaluation(morgan):
+    client, model, plan = _plan_and_model(morgan)
+    scenario = {"retirement_age": 69, "employee_contribution_rate": None}
+    calls_before = len(model.calls)
+
+    fast = client.post("/v1/evaluate", json={"profile": morgan, "scenario": scenario,
+                                             "reuse_decision": plan["decision_summary"]})
+    assert fast.status_code == 200
+    assert len(model.calls) == calls_before, "no recommendation or explanation call"
+    fast = fast.json()
+    assert fast["explanation"]["source"] == "template"
+    assert fast["decision_summary"]["source"] == "ai"
+    assert fast["decision_summary"]["ordered_priorities"] == plan["decision_summary"]["ordered_priorities"]
+
+    full = client.post("/v1/evaluate", json={"profile": morgan, "scenario": scenario}).json()
+    assert fast["input_hash"] == full["input_hash"]
+    assert fast["projections"] == full["projections"]
+
+
+def test_rules_fallback_decision_is_reusable(morgan):
+    client = make_client(None, evaluations_per_minute=1000)
+    plan = client.post("/v1/evaluate", json={"profile": morgan}).json()
+    assert plan["decision_summary"]["source"] == "rules_fallback"
+    fast = client.post("/v1/evaluate", json={"profile": morgan, "scenario": {"retirement_age": 69},
+                                             "reuse_decision": plan["decision_summary"]})
+    assert fast.status_code == 200
+    assert fast.json()["decision_summary"]["fallback_reason"] == plan["decision_summary"]["fallback_reason"]
+
+
+def test_a_decision_that_no_longer_validates_takes_the_normal_path(morgan):
+    client, model, plan = _plan_and_model(morgan)
+    tampered = copy.deepcopy(plan["decision_summary"])
+    tampered["ordered_priorities"] = ["full_reserve", "starter_reserve", "high_apr_debt"]  # not a documented order
+    calls_before = len(model.calls)
+    r = client.post("/v1/evaluate", json={"profile": morgan, "scenario": {"retirement_age": 69},
+                                          "reuse_decision": tampered})
+    assert r.status_code == 200
+    assert len(model.calls) > calls_before, "fell back to asking the model"
+    assert r.json()["decision_summary"]["ordered_priorities"] != tampered["ordered_priorities"]
