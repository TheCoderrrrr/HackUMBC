APP_ENV=hackathon

# AI provider: openai (team default, GPT-6 Luna) or gemini.
# Without the key for the selected provider, the API runs on the rules fallback.
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
OPENAI_API_KEY=
# OpenAI reasoning effort: none | minimal | low | medium | high
AI_REASONING_EFFORT=low
AI_TOTAL_TIMEOUT_SECONDS=4

# Gemini (only used when AI_PROVIDER=gemini; then set AI_MODEL=gemini-3.5-flash-lite)
GEMINI_API_KEY=
# minimal | low | medium | high | none (none = send no thinking setting)
AI_THINKING_LEVEL=minimal

# Plaid Sandbox is a post-MVP stretch; keep disabled.
PLAID_ENABLED=false

SESSION_TTL_SECONDS=7200
