APP_ENV=hackathon

# AI provider: gemini (team default, Gemini 3.5 Flash-Lite — both AI calls fit the
# 4-second budget) or openai (GPT-6 Luna; only fits the budget with
# AI_REASONING_EFFORT=none, and most explanations then fall back to templates).
# Without the key for the selected provider, the API runs on the rules fallback.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# minimal | low | medium | high | none (none = send no thinking setting)
AI_THINKING_LEVEL=minimal
AI_TOTAL_TIMEOUT_SECONDS=4

# OpenAI (only used when AI_PROVIDER=openai; then set AI_MODEL=gpt-6-luna)
OPENAI_API_KEY=
AI_REASONING_EFFORT=low

# Plaid Sandbox is a post-MVP stretch; keep disabled.
PLAID_ENABLED=false

# Shared demo key for the public tunnel (REPORT C2). When set, /v1/* requires the
# X-Demo-Key header; the app sends it from its git-ignored local xcconfig. Keep
# empty for local development.
DEMO_KEY=

SESSION_TTL_SECONDS=7200

# Scenario history on Tiger Data (optional). Paste the Tiger Cloud service URL here;
# leave empty to disable history. /v1/evaluate never depends on it.
TIGER_DATABASE_URL=
TIGER_SCHEMA=arm
