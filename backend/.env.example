APP_ENV=hackathon

# AI (Gemini Flash). Without GEMINI_API_KEY the API runs on the rules fallback.
AI_ENABLED=true
AI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
AI_THINKING_LEVEL=
AI_PROMPT_VERSION=1
AI_TOTAL_TIMEOUT_SECONDS=4

# Plaid Sandbox is a post-MVP stretch; keep disabled.
PLAID_ENABLED=false

SESSION_TTL_SECONDS=7200
